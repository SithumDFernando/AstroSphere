{
  "name": "astrosphere-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch-path=src --watch-path=scripts scripts/dev.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "npm run build && node test/workbench.browser.mjs && node test/learning.browser.mjs && node test/storage.browser.mjs",
    "test:pilot": "npm run build && node test/pilot.browser.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.180.0"
  }
}
